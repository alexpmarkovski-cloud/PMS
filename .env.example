# Copy to .env.local and fill in.
#
# Local dev: run `supabase start` and use the values it prints
#   (API URL → NEXT_PUBLIC_SUPABASE_URL, anon key, service_role key).
# Production: use the project's values from the Supabase dashboard
#   (Settings → API). The service role key is secret — server-only,
#   never given a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App-level transactional email (maintenance alerts). Leave unset locally —
# defaults target the local Supabase Mailpit (127.0.0.1:54325, no auth).
# Production: Gmail/Workspace SMTP per launch_decisions.md item 7.
# SMTP_HOST=
# SMTP_PORT=
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="PMS <alerts@example.com>"

# AI triage pipeline (launch_decisions.md item 17).
# Pick a provider with AI_PROVIDER ("gemini" or "claude"; defaults to gemini)
# and set that provider's API key. To use a different model, set
# GEMINI_MODEL or ANTHROPIC_MODEL to any model id the provider lists —
# unset, they default to gemini-3.8-flash and claude-opus-5-5.
# Restart `npm run dev` after changing any of these.
# AI_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
